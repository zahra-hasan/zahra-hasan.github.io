---
import Article from '../../layouts/Article.astro';
import { entriesOf } from '../../lib/entries';
import type { Entry } from '../../lib/model';

export async function getStaticPaths() {
  const posts = await entriesOf('post');
  return posts.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props as { entry: Entry };
---
<Article entry={entry} back={{ href: '/writing/', label: 'All writing' }} />

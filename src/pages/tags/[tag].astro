---
import Base from '../../layouts/Base.astro';
import PostItem from '../../components/PostItem.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { tagsWithCounts, withTag } from '../../lib/entries';
import type { Entry } from '../../lib/model';
import { tagSlug } from '../../lib/paths';

export async function getStaticPaths() {
  const tags = await tagsWithCounts();
  return Promise.all(tags.map(async ({ tag }) => ({
    params: { tag: tagSlug(tag) },
    props: { tag, entries: await withTag(tag) },
  })));
}

const { tag, entries } = Astro.props as { tag: string; entries: Entry[] };
const posts = entries.filter((e) => e.kind === 'post');
const projects = entries.filter((e) => e.kind === 'project');
---
<Base title={`#${tag}`} description={`Writing and projects tagged ${tag}.`}>
  <div class="container narrow">
    <header class="page-head">
      <p class="eyebrow"><a href="/writing/">Writing</a> / Tag</p>
      <h1>#{tag}</h1>
    </header>
    {projects.length > 0 && (
      <section>
        <h2 class="eyebrow label">Projects</h2>
        <div class="grid">{projects.map((p) => <ProjectCard entry={p} />)}</div>
      </section>
    )}
    {posts.length > 0 && (
      <section>
        <h2 class="eyebrow label">Writing</h2>
        {posts.map((p) => <PostItem entry={p} />)}
      </section>
    )}
  </div>
</Base>

<style>
  .narrow { max-width: 860px; }
  section { margin-top: 36px; }
  .label { margin-bottom: 12px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: 18px; }
</style>

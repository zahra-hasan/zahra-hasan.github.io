---
import Article from '../../layouts/Article.astro';
import { entriesOf } from '../../lib/entries';
import type { Entry } from '../../lib/model';

export async function getStaticPaths() {
  const projects = await entriesOf('project');
  return projects.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props as { entry: Entry };
---
<Article entry={entry} back={{ href: '/projects/', label: 'All projects' }} />

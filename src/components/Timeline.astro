---
import type { Entry } from '../lib/model';
import { formatDate } from '../lib/entries';

interface Props { milestones: Entry[] }
const { milestones } = Astro.props;
---
<ol class="timeline">
  {milestones.map((m) => (
    <li>
      <span class="dot" aria-hidden="true"></span>
      <time class="eyebrow" datetime={m.date}>{formatDate(m.date, 'short')}</time>
      <h3>{m.title}</h3>
      {m.summary && <p>{m.summary}</p>}
    </li>
  ))}
</ol>

<style>
  .timeline { list-style: none; margin: 0; padding: 0 0 0 28px; position: relative; }
  .timeline::before { content: ''; position: absolute; left: 9px; top: 8px; bottom: 8px; width: 2px; background: var(--line); border-radius: 2px; }
  li { position: relative; padding-bottom: 26px; }
  li:last-child { padding-bottom: 0; }
  .dot {
    position: absolute; left: -28px; top: 2px;
    width: 20px; height: 20px; border-radius: 999px;
    display: grid; place-items: center; font-size: 11px;
    background: var(--surface); border: 2px solid var(--accent);
  }
  li:first-child .dot { background: var(--accent); }
  h3 { font-size: 17px; margin-top: 2px; }
  p { margin: 4px 0 0; color: var(--ink-2); font-size: 15.5px; }
</style>
